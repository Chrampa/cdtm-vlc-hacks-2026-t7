# Copy to .env (git-ignored). Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.ironlane.ai/v1
# Either the key itself...
# LLM_API_KEY=
# ...or a file that contains it (preferred: keeps the key out of the project folder)
LLM_API_KEY_FILE=~/.pi/agent/ironlane.key

# One model for everything, or override per task
LLM_MODEL=deepseek/deepseek-v4.1-flash
# MODEL_INTERPRET=   # brief -> structured requirements (needs good JSON + reasoning)
# MODEL_EXPLAIN=     # evidence-cited candidate summaries (many small parallel calls)
# MODEL_TEAM=        # team review
# LLM_CONCURRENCY=8

# DATA_PATH=data/profiles.parquet
